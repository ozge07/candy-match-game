<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ acilis ekrani.
     Bu surumlerden itibaren launch_background yok sayiliyor; acilis ekranini
     sistem ciziyor. Zemin rengini burada acikca vermezsek sistem varsayilana
     donuyor ve oyunun koyu temasina beyaz bir sicramayla giriliyor. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
